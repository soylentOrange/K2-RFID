{
  "name": "k2rfid-web",
  "private": true,
  "version": "1.2.0",
  "description": "Web app for the K2-RFID tag programmer (embedded on the device and hosted on GitHub Pages)",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:device && npm run build:pages",
    "build:device": "vite build --mode device",
    "build:pages": "vite build --mode pages",
    "build:webserial": "html-minifier-terser --config-file minify.config.json -o ../.pio/embed/webserial.html ../assets/embed_html/webserial.html",
    "preview": "vite preview --mode pages",
    "mock": "node tools/mock-device.js"
  },
  "devDependencies": {
    "html-minifier-terser": "^7.2.0",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "ws": "^8.23.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
